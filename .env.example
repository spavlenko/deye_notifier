# Create an app at https://developer.deyecloud.com/app to get these
DEYE_APP_ID=
DEYE_APP_SECRET=
# Your Deye Cloud account login (plain password or its SHA-256 hex)
DEYE_EMAIL=
DEYE_PASSWORD=
# EU accounts: eu1, others may need https://us1-developer.deyecloud.com/v1.0
DEYE_BASE_URL=https://eu1-developer.deyecloud.com/v1.0

# Optional: auto-detected if empty (use `python -m deye_notifier stations`)
DEYE_STATION_ID=
DEYE_DEVICE_SN=

# Seconds between polls (Deye Cloud updates roughly every 1-5 min)
POLL_INTERVAL=120
# Grid is "on" if any grid voltage >= this
GRID_VOLTAGE_THRESHOLD=100
# Comma-separated field names; auto-detected if empty (see `dump`)
GRID_VOLTAGE_KEYS=
# Data older than this (seconds) is treated as unknown
STALE_AFTER=900
# Notify when battery charge drops below this % (0 = off). Re-arms at +5%.
BATTERY_LOW_SOC=45
# While on battery (grid down): warn when a phase or the total load reaches this %
# of inverter capacity (RatedPower; per phase = RatedPower / 3). 0 = off.
OVERLOAD_PERCENT=80
# Temperature alerts, °C (re-arm 3°C back inside the range). Empty = default.
BATTERY_TEMP_MAX=45
BATTERY_TEMP_MIN=5
INVERTER_TEMP_MAX=70
# "Battery not charging": grid on for this many minutes, SOC below the limit and not rising. 0 = off.
NOT_CHARGING_MINUTES=30
NOT_CHARGING_BELOW_SOC=95
# Notify on inverter/battery alerts from Deye Cloud (1/0)
ALERTS_ENABLED=1
# Comma-separated alert names to skip (substring match). Grid_Phase_Wrong fires on
# every grid flicker; outages are already reported separately. Empty = notify all.
ALERT_IGNORE=Grid_Phase_Wrong
DATA_DIR=data

# Optional Telegram bot (create with @BotFather). Users subscribe via /start in the bot.
TELEGRAM_BOT_TOKEN=

# Timezone for message times and "today" in statistics
TZ=Europe/Kyiv
